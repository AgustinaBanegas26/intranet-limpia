# Frontend (Vite)
# Copiar a .env.local para desarrollo local

# URL del backend Express (sin barra final)
# Para desarrollo local usar http://localhost:4000
VITE_BACKEND_URL=

# Supabase (frontend) — copiar estas desde el proyecto Supabase (Settings → API)
# En Vercel, configurá estas variables en el dashboard como VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
# Set this to your Supabase project's anon/public key (Settings -> API -> anon key)
VITE_SUPABASE_ANON_KEY=
#h