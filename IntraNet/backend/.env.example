# Backend Express — copiar a .env y completar valores reales

# Obligatorio: secreto largo y aleatorio (mín. 32 caracteres en producción)
JWT_SECRET=
# Supabase (proyecto → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Producción: orígenes del frontend separados por coma (sin barra final)
# Ejemplo: https://portal.example.com
CORS_ORIGINS=
# Puerto del API (opcional, default 4000)
PORT=4000

# Entorno: en producción usar production (valida CORS + Supabase al arrancar)
NODE_ENV=development

# --- Smoke test empleado (npm run smoke) ---
# URL pública del API (sin barra final)
SMOKE_BASE_URL=http://localhost:4000
SMOKE_EMAIL=
SMOKE_PASSWORD=

# Email notifications (optional; leave blank to disable delivery)
EMAIL_USER=
EMAIL_PASS=
EMAIL_AGUSTINA=
EMAIL_SARA=
EMAIL_RRHH=
EMAIL_PROVEEDORES=
EMAIL_TESORERIA=
EMAIL_MATIAS=
EMAIL_LUCIANO=
EMAIL_JAVIER=
EMAIL_SISTEMAS=
EMAIL_AUDITORIA=
EMAIL_CAJA_MDP=
EMAIL_CAJA_BRASIL=

# Contraseña por defecto al crear empleados (opcional)
# DEFAULT_NEW_EMPLOYEE_PASSWORD=Empleado123!

# --- Fase 0 producción ---
# 1. Copiar este archivo a .env y completar valores
# 2. NODE_ENV=production + CORS_ORIGINS + JWT_SECRET (32+ chars)
# 3. Ejecutar migraciones en Supabase (ver migrations/README.md)
# 4. npm run check:env && npm start
# 5. npm run smoke (con SMOKE_EMAIL / SMOKE_PASSWORD de un empleado activo)
# Frontend (build aparte): VITE_BACKEND_URL=<esta API> en el host del front
